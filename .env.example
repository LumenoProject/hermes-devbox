# Copy to .env and adjust. Never commit .env with real secrets.

# Image to run (defaults to the CI-published image; set to a local build with
# HERMES_IMAGE=hermes-devbox:local, or pin the upstream base digest via the
# Dockerfile's HERMES_IMAGE build arg).
#HERMES_IMAGE=ghcr.io/lumenoproject/hermes-devbox:latest

# Owner UID/GID for files created under /opt/data (default: image's hermes user).
#HERMES_UID=10000
#HERMES_GID=10000

# Host bind address for published ports (only used when ports are uncommented).
#HERMES_BIND_IP=127.0.0.1

# Web dashboard basic auth (required for any non-loopback dashboard bind).
#HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
#HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
#HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me-too

# OpenAI-compatible API server key (min 8 chars; generate: openssl rand -hex 32).
#API_SERVER_KEY=
